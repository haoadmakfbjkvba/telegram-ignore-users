+    /// Unseen mentions in hidden messages (of people ignored in groups) that lie between the messages on screen.
+    private func hiddenUnseenMentionIds(historyView: ChatHistoryView, visible: ListViewVisibleItemRange) -> [MessageId] {
+        guard let peerId = self.chatLocation.peerId, peerId.namespace == Namespaces.Peer.CloudGroup || peerId.namespace == Namespaces.Peer.CloudChannel else {
+            return []
+        }
+        let ignored = Set(IgnoredMembers.shared.list(accountPeerId: self.context.account.peerId))
+        let count = historyView.filteredEntries.count
+        guard !ignored.isEmpty, visible.firstIndex <= visible.lastIndex, visible.lastIndex < count else {
+            return []
+        }
+        // The list runs from the newest: the oldest entry on screen is the last of the visible range. The bounds are
+        // the shown entries just past those on screen (open where the screen reaches the end of what is shown), so that
+        // hidden mentions right before or after the screen count too.
+        let lowerIndex: MessageIndex? = visible.lastIndex + 1 < count ? historyView.filteredEntries[count - 1 - (visible.lastIndex + 1)].index : nil
+        let upperIndex: MessageIndex? = visible.firstIndex > 0 ? historyView.filteredEntries[count - 1 - (visible.firstIndex - 1)].index : nil
+        var chatPeer: Peer?
+        for entry in historyView.originalView.additionalData {
+            if case let .peer(_, peer) = entry {
+                chatPeer = peer
+            }
+        }
+        var result: [MessageId] = []
+        for entry in historyView.originalView.entries where (lowerIndex.flatMap { entry.index > $0 } ?? true) && (upperIndex.flatMap { entry.index < $0 } ?? true) {
+            let message = entry.message
+            guard message.tags.contains(.unseenPersonalMessage), chatHistoryHidesIgnored(message: message, chatPeer: chatPeer, location: self.chatLocation, ignoredAuthorIds: ignored) else {
+                continue
+            }
+            if message.attributes.contains(where: { ($0 as? ConsumablePersonalMentionMessageAttribute).flatMap({ !$0.pending }) ?? false }) {
+                result.append(message.id)
+            }
+        }
+        return result
+    }
