+/// The author of `messages` if they can be ignored from here: someone else's messages (all of one person, not a bot)
+/// in a group or in the comments of a channel.
+private func ignorableAuthor(chatPresentationInterfaceState: ChatPresentationInterfaceState, context: AccountContext, messages: [EngineRawMessage]) -> TelegramUser? {
+    guard let first = messages.first, let author = first.author as? TelegramUser, author.id != context.account.peerId, author.botInfo == nil else {
+        return nil
+    }
+    guard messages.allSatisfy({ $0.author?.id == author.id && $0.effectivelyIncoming(context.account.peerId) && ($0.id.namespace == Namespaces.Message.Cloud || $0.id.namespace == Namespaces.Message.Local) }) else {
+        return nil
+    }
+    switch chatPresentationInterfaceState.subject {
+    case .none, .message:
+        break
+    default:
+        return nil
+    }
+    if case .customChatContents = chatPresentationInterfaceState.chatLocation {
+        return nil
+    }
+    guard IgnoredMembers.hides(message: first, ignored: Set([author.id])) else {
+        return nil
+    }
+    return author
+}
