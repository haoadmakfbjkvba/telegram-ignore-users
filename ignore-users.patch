+    /// How many loaded messages are not shown past the first and the last shown ones, while people are ignored in groups
+    /// (else none: the history loads as it always does).
+    private func ignoredHiddenPastEdges(_ historyView: ChatHistoryView, firstIndex: MessageIndex, lastIndex: MessageIndex) -> (earlier: Int, later: Int) {
+        guard self.ignoredEdgeIndices(historyView) != nil else {
+            return (0, 0)
+        }
+        var earlier = 0
+        var later = 0
+        for entry in historyView.originalView.entries {
+            if entry.index < firstIndex {
+                earlier += 1
+            } else if entry.index > lastIndex {
+                later += 1
+            }
+        }
+        return (earlier, later)
+    }
