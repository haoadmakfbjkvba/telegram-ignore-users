+
+/// How many of the messages of `view` are hidden for each ignored author.
+func chatHistoryIgnoredAuthorCounts(view: MessageHistoryView, location: ChatLocation, ignoredAuthorIds: Set<PeerId>) -> [PeerId: Int] {
+    guard !ignoredAuthorIds.isEmpty else {
+        return [:]
+    }
+    var chatPeer: Peer?
+    for entry in view.additionalData {
+        if case let .peer(_, peer) = entry {
+            chatPeer = peer
+        }
+    }
+    var counts: [PeerId: Int] = [:]
+    for entry in view.entries {
+        if let authorId = entry.message.author?.id, chatHistoryHidesIgnored(message: entry.message, chatPeer: chatPeer, location: location, ignoredAuthorIds: ignoredAuthorIds) {
+            counts[authorId, default: 0] += 1
+        }
+    }
+    return counts
+}
